{
  "name": "goldprice-tauri",
  "version": "2.3.16",
  "description": "Gold price desktop client (Tauri)",
  "scripts": {
    "frontend:dev": "vite --host 127.0.0.1 --port 5173",
    "frontend:build": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows:x64": "tauri build --target x86_64-pc-windows-msvc",
    "build:release": "tauri build --bundles nsis,updater",
    "build:release:windows:x64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis,updater",
    "build:all": "npm run build:release:windows:x64",
    "setver": "node scripts/setver.js",
    "updater:keygen": "tauri signer generate -w %USERPROFILE%/.tauri/goldprice-updater.key"
  },
  "author": "Lucas",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "echarts": "^6.0.0",
    "tdesign-vue-next": "^1.18.1",
    "vue": "^3.5.25"
  }
}
